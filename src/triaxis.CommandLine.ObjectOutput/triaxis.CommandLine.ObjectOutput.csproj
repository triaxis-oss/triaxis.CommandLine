<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\triaxis.CommandLine\triaxis.CommandLine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <!-- ILLink only rewrites assemblies marked trimmable; everything else is copied
         wholesale, which silently ignores the substitutions below. The netstandard TFMs
         cannot use <IsTrimmable>, so the underlying attribute is emitted directly. -->
    <AssemblyMetadata Include="IsTrimmable" Value="True" />
    <EmbeddedResource Include="ILLink.Substitutions.xml">
      <LogicalName>ILLink.Substitutions.xml</LogicalName>
    </EmbeddedResource>
    <!-- NuGet: pack the transitive targets that map the MSBuild property to the switch -->
    <None Include="$(MSBuildThisFileDirectory)buildTransitive\triaxis.CommandLine.ObjectOutput.targets"
          Pack="true"
          PackagePath="buildTransitive"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="triaxis.CommandLine.ObjectOutput.Tests" />
  </ItemGroup>

</Project>
