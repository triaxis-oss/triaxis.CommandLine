<Project>
  <!-- The readme is packed as a rewritten copy, not the original: nuget.org resolves a relative
       link against the package page, so an unrewritten link to docs/ takes the reader nowhere.
       The published package outlives the commit it was built from, so a release passes its own
       tag and the links keep saying what the package says. -->
  <PropertyGroup>
    <_SourceReadme>$(MSBuildThisFileDirectory)README.md</_SourceReadme>
    <_PackedReadme>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)README.md</_PackedReadme>
    <ReadmeLinkRef Condition="'$(ReadmeLinkRef)' == ''">main</ReadmeLinkRef>
    <_ReadmeLinkBase>$(RepositoryUrl)/blob/$(ReadmeLinkRef)/</_ReadmeLinkBase>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(_PackedReadme)" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <UsingTask TaskName="AbsolutizeMarkdownLinks" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <BaseUrl ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = Regex.Replace(
            File.ReadAllText(Source),
            @"(?<=\]\()(?![a-zA-Z][a-zA-Z0-9+.-]*:|[#/])",
            BaseUrl);
        Directory.CreateDirectory(Path.GetDirectoryName(Destination));
        if (!File.Exists(Destination) || File.ReadAllText(Destination) != text)
        {
            File.WriteAllText(Destination, text);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="RewriteReadmeLinks" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <AbsolutizeMarkdownLinks Source="$(_SourceReadme)" Destination="$(_PackedReadme)"
                             BaseUrl="$(_ReadmeLinkBase)" />
  </Target>

  <!-- Make the source generator available to all projects in this repo -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\triaxis.CommandLine.SourceGenerator\triaxis.CommandLine.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Expose the generator's MSBuild inputs to in-repo projects. For consumers that
       reference the NuGet package these come from buildTransitive/triaxis.CommandLine.targets,
       but that file isn't imported by plain ProjectReferences, so we mirror it here. -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true'">
    <CompilerVisibleProperty Include="TriaxisCommandLineConfigOverridePath" />
    <CompilerVisibleProperty Include="TriaxisCommandLineEnvironmentVariablePrefix" />
  </ItemGroup>
</Project>
